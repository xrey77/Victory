@implementation BooksViewController

@synthesize booksData, BookName, BookPrice, BookImage, scrollView, vstackView,lblTitle,BookDescription,BookAuthor;
@synthesize lblBookname,lblDescription,lblPrice,imgBook,btnDtl,viewDetails,data,lblAuthor,BookId,lblIdno;
@synthesize lblBooknameTitle, lblDescriptionTitle, lblAuthorTitle, lblPriceTitle, btnCart, btnCancel, dtlPrice,dtlBookname, dtlimgBook,dtlAuthor,dtlDescription;
- (void)viewDidLoad {
    [super viewDidLoad];
    [self viewDetailsData];
    


}

-(void)viewDetailsData {

    self->lblTitle = [[UILabel alloc] initWithFrame:CGRectMake(10,10,330,50)];
    NSDateFormatter *dateFormatter=[[NSDateFormatter alloc] init];
    [dateFormatter setDateFormat:@"MMMM dd, yyyy"];
    // or @"yyyy-MM-dd hh:mm:ss a" if you prefer the time with AM/PM
    
    NSString *xtitle = @"List of Books as of ";
    
    self->lblTitle.text = [xtitle stringByAppendingString:[dateFormatter stringFromDate:[NSDate date]]];
    self->lblTitle.textColor = UIColor.whiteColor;
    self->lblTitle.textAlignment = NSTextAlignmentLeft;
    self->lblTitle.font = [UIFont fontWithName:@"Arial" size:18];

    
    self.scrollView = [[UIScrollView alloc] initWithFrame:CGRectMake(0, 0, self.view.frame.size.width, self.view.frame.size.height)];
    [self.scrollView setContentSize:(CGSizeMake(self.view.frame.size.width, self.view.frame.size.height*10))];
    self.scrollView.showsVerticalScrollIndicator = false;
    
    self->vstackView = [[UIStackView alloc] initWithFrame:CGRectMake(0, 0, self.view.frame.size.width, self.view.frame.size.height)];
    [self.view addSubview:self->scrollView];
    
    self->vstackView.axis = UILayoutConstraintAxisVertical;
    self->vstackView.alignment = UIStackViewAlignmentFill;
    self->vstackView.backgroundColor = UIColor.clearColor;
    self->vstackView.distribution = UIStackViewDistributionFill;
    [self.view addSubview:self->vstackView];
    [self.vstackView addSubview:self->lblTitle];

    self->_subView = [[UIView alloc] init];

    self->BookId = [[NSMutableArray alloc] init];
    self->booksData = [[NSMutableArray alloc] init];
    self->BookName = [[NSMutableArray alloc] init];
//    self->BookAuthor = [[NSMutableArray alloc] init];
    self->BookPrice = [[NSMutableArray alloc] init];
    self->BookImage = [[NSMutableArray alloc] init];
//    self->BookDescription = [[NSMutableArray alloc] init];

    [self fetchBooksData];

    int64_t delay = 3.0; // In seconds
    dispatch_time_t time = dispatch_time(DISPATCH_TIME_NOW, delay * NSEC_PER_SEC);
    dispatch_after(time, dispatch_get_main_queue(), ^(void){
        
//        BOOK NAME======================
        long yrow1 = 100;
        long yrow2 = 200;

        NSMutableArray *bookNameArray = self->booksData[0];
        NSMutableArray *bookPriceArray = self->booksData[1];
        NSMutableArray *bookImageArray = self->booksData[2];
        NSMutableArray *bookIdArray = self->booksData[3];

        for (int i = 0; i < [bookNameArray count]; i++) {
            self->imgBook = [[UIImageView alloc]initWithFrame:CGRectMake(10,yrow1,100, 100)];
            NSString *url = @"http://127.0.0.1:9000/assets/ccfbooks/";
            url = [url stringByAppendingString:bookImageArray[i]];
            
            NSURL *nsUrl = [NSURL URLWithString:url];
            NSData *data = [NSData dataWithContentsOfURL:nsUrl];
            self->imgBook.image = [UIImage imageWithData:data];
            self->imgBook.userInteractionEnabled = true;
            self->imgBook.clipsToBounds = true;
            self->imgBook.layer.cornerRadius = 10;
            [self->_subView addSubview:self->imgBook];
            [self->vstackView addArrangedSubview:self->_subView];
            
            self->lblBookname = [[UILabel alloc] initWithFrame:CGRectMake(130,yrow1,250,50)];
            self->lblBookname.text = bookNameArray[i];
            self->lblBookname.textColor = UIColor.whiteColor;
            self->lblBookname.textAlignment = NSTextAlignmentLeft;
            self->lblBookname.font = [UIFont fontWithName:@"Arial" size:18];
            self->lblBookname.numberOfLines = 2;
            [self->lblBookname setLineBreakMode:NSLineBreakByWordWrapping];
            [self->lblBookname sizeToFit];
            self->lblBookname.lineBreakMode = NSLineBreakByWordWrapping;
            [self->_subView addSubview:self->lblBookname];
            [self->vstackView addArrangedSubview: self->_subView];

            
            if (self->lblBookname.frame.size.height > 20.50) {
                self->dtlPrice = [[UILabel alloc] initWithFrame:CGRectMake(130,yrow1+30,330,50)];
                self->dtlPrice.text = [@"Price : " stringByAppendingString:bookPriceArray[i]];
                self->dtlPrice.textColor = UIColor.whiteColor;
                self->dtlPrice.textAlignment = NSTextAlignmentLeft;
                self->dtlPrice.font = [UIFont fontWithName:@"Arial" size:18];
                [self->_subView addSubview:self->dtlPrice];
                
                self->lblIdno = [[UILabel alloc] initWithFrame:CGRectMake(250,yrow1+10,330,50)];
                self->lblIdno.text = [NSString stringWithFormat:@"%@", bookIdArray[i]];
                self->lblIdno.textColor = UIColor.whiteColor;
                [self->_subView addSubview:self->lblIdno];

                
                [self->vstackView addArrangedSubview: self->_subView];
                
                self->btnDtl = [[UIImageView alloc]initWithFrame:CGRectMake(130,yrow1+70,100, 28)];
                self->btnDtl.image = [UIImage imageNamed:@"details"];
                self->btnDtl.userInteractionEnabled = true;

                MYTapGestureRecognizer *tapDtlGesture = [[MYTapGestureRecognizer alloc] initWithTarget:self action:@selector(dtlImageTapped:)];
//                tapDtlGesture.bookId = self->lblIdno.text;
                tapDtlGesture.numberOfTapsRequired = 1;
                [tapDtlGesture setDelegate:nil];
                self->btnDtl.tag = i;
                [self->btnDtl addGestureRecognizer:tapDtlGesture];
                self->btnDtl.backgroundColor = UIColor.clearColor;
                self->btnDtl.tintColor = UIColor.whiteColor;
                [self->_subView addSubview:self->btnDtl];
                [self->vstackView addArrangedSubview: self->_subView];


            } else {
                self->dtlPrice = [[UILabel alloc] initWithFrame:CGRectMake(130,yrow1+10,330,50)];
                self->dtlPrice.text = [@"Price : " stringByAppendingString:bookPriceArray[i]];
                self->dtlPrice.textColor = UIColor.whiteColor;
                self->dtlPrice.textAlignment = NSTextAlignmentLeft;
                self->dtlPrice.font = [UIFont fontWithName:@"Arial" size:18];
                [self->_subView addSubview:self->dtlPrice];

                self->lblIdno = [[UILabel alloc] initWithFrame:CGRectMake(250,yrow1+10,330,50)];
                self->lblIdno.text = [NSString stringWithFormat:@"%@", bookIdArray[i]];
                self->lblIdno.textColor = UIColor.whiteColor;
                [self->_subView addSubview:self->lblIdno];

                
                
                [self->vstackView addArrangedSubview: self->_subView];

                self->btnDtl = [[UIImageView alloc]initWithFrame:CGRectMake(130,yrow1+50,100,28)];
                self->btnDtl.image = [UIImage imageNamed:@"details"];
                self->btnDtl.userInteractionEnabled = true;
//                MYTapGestureRecognizer *tapDtlGesture = [[MYTapGestureRecognizer alloc] initWithTarget:self action:@selector(dtlImageTapped:)];

                MYTapGestureRecognizer *tapDtlGesture = [[MYTapGestureRecognizer alloc] initWithTarget:self action:@selector(dtlImageTapped:)];

                //[self performSelector:@selector(adding::)withObject:@"num1" withObject:@"num2"];

//                tapDtlGesture.bookId = self->lblIdno.text;
                tapDtlGesture.numberOfTapsRequired = 1;
                [tapDtlGesture setDelegate:nil];



                [self->btnDtl addGestureRecognizer:tapDtlGesture];
                self->btnDtl.backgroundColor = UIColor.clearColor;
                self->btnDtl.tintColor = UIColor.whiteColor;
                [self->_subView addSubview:self->btnDtl];
                [self->vstackView addArrangedSubview: self->_subView];

            }
            yrow1 += 150;
            yrow2 += 200;

        }

    });
        [self.scrollView addSubview:self->vstackView];
}


